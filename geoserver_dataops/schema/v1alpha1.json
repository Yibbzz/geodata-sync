{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yibbzz/geoserver-dataops/geoserver_dataops/schema/v1alpha1.json",
  "title": "dataops resource (v1alpha1)",
  "description": "One resource of a dataops project: docs/spec.md",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "dataops/v1alpha1"
    },
    "kind": {
      "enum": [
        "Project",
        "Source",
        "Dataset"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/resourceName"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Project"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/project"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Source"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Dataset"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/dataset"
          }
        }
      }
    }
  ],
  "$defs": {
    "resourceName": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "lowercase letters, digits and dashes, starting and ending with a letter or digit"
    },
    "tableName": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]{0,62}$",
      "description": "lowercase letters, digits and _, not starting with a digit, at most 63 characters"
    },
    "secretRef": {
      "type": "object",
      "required": [
        "secret"
      ],
      "additionalProperties": false,
      "properties": {
        "secret": {
          "$ref": "#/$defs/resourceName"
        }
      }
    },
    "crs": {
      "type": "string",
      "pattern": "^EPSG:[0-9]+$"
    },
    "schedule": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "manual"
          ]
        },
        {
          "pattern": "^\\S+( \\S+){4}$",
          "description": "A five-field cron expression"
        }
      ],
      "description": "daily, weekly, monthly, manual, or a five-field cron expression such as '0 3 * * 1'"
    },
    "project": {
      "type": "object",
      "required": [
        "database"
      ],
      "additionalProperties": false,
      "properties": {
        "database": {
          "type": "object",
          "required": [
            "connection"
          ],
          "additionalProperties": false,
          "properties": {
            "connection": {
              "$ref": "#/$defs/secretRef"
            },
            "schemas": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "live": {
                  "$ref": "#/$defs/tableName"
                },
                "staging": {
                  "$ref": "#/$defs/tableName"
                },
                "backup": {
                  "$ref": "#/$defs/tableName"
                }
              }
            }
          }
        },
        "crs": {
          "$ref": "#/$defs/crs"
        },
        "backups": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "A source type: os-downloads, url, ckan, ogc-api-features, wfs, arcgis, stac, ogc-api-records, csw, socrata, opendatasoft, overture, geofabrik, koordinates, atom, overpass, files, database, data-europa, usgs, geonode, or one a plugin adds (docs/plugins.md)",
          "examples": [
            "os-downloads",
            "url",
            "ckan",
            "ogc-api-features",
            "wfs",
            "arcgis",
            "stac",
            "ogc-api-records",
            "csw",
            "socrata",
            "opendatasoft",
            "overture",
            "geofabrik",
            "koordinates",
            "atom",
            "overpass",
            "files"
          ]
        },
        "credentials": {
          "$ref": "#/$defs/secretRef"
        },
        "url": {
          "type": "string",
          "pattern": "^((https?|file|s3|gs|az|sftp|ftps?|postgresql|postgres|postgis|mysql|mariadb)://|/|[A-Za-z]:[\\\\/])",
          "description": "The source's address: a CKAN portal (e.g. https://data.gov.uk), a WFS or OGC API endpoint, an ArcGIS REST services directory, a STAC API, a catalogue (OGC API Records, CSW), a Socrata, OpenDataSoft or Koordinates portal, an INSPIRE Atom service feed, an Overpass API instance; for files, a folder, bucket or server: /mnt/drop/ (or file:///mnt/drop/), sftp://user@host/path/, ftp://host/path/, s3://bucket/prefix/, gs://bucket/prefix/, az://account/container/prefix/; for database, postgresql://host:5432/dbname or mysql://host:3306/dbname"
        },
        "options": {
          "type": "object",
          "description": "Settings of the source type: for files, endpoint (an S3-compatible store's address), region and pathStyle, or an SFTP server's hostKey; for stac, login, tokenUrl, clientId, tokenHosts, and endpoint and region for s3:// files; for arcgis, tokenUrl (an Enterprise portal's generateToken); a plugin's own",
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^https?://"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "pathStyle": {
              "type": "boolean"
            },
            "hostKey": {
              "type": "string",
              "pattern": "^SHA256:",
              "description": "an SFTP server's key, as ssh-keygen -lf shows it"
            },
            "identity": {
              "enum": [
                "aws",
                "google",
                "azure"
              ],
              "description": "for files on a bucket: also ask the machine's own cloud identity (an EC2 instance role, GKE or Compute Engine's service account, an Azure managed identity)"
            },
            "login": {
              "enum": [
                "copernicus"
              ],
              "description": "stac: where a username and password log in (Copernicus Data Space)"
            },
            "tokenUrl": {
              "type": "string",
              "pattern": "^https://",
              "description": "stac: an OAuth token address a username and password log in at"
            },
            "clientId": {
              "type": "string",
              "minLength": 1,
              "description": "stac: the OAuth client the token address expects"
            },
            "tokenHosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "stac: other hosts the login token may be sent to (it goes only to the catalogue's own domain otherwise)"
            }
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/resourceName"
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "description": "Which download of a CKAN package, or link of a catalogue record, to load: its ID, name or address"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "update": {
          "$ref": "#/$defs/schedule"
        },
        "tables": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/tableName"
              },
              "crs": {
                "$ref": "#/$defs/crs"
              }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dropInvalidGeometries": {
              "type": "boolean"
            },
            "minRows": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "overture": {
          "type": "object",
          "required": [
            "bbox"
          ],
          "additionalProperties": false,
          "description": "the area of an Overture type to load",
          "properties": {
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "the area, in degrees: [west, south, east, north]"
            }
          }
        },
        "overpass": {
          "type": "object",
          "required": [
            "bbox"
          ],
          "additionalProperties": false,
          "description": "the area to ask Overpass for",
          "properties": {
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "the area, in degrees: [west, south, east, north]"
            }
          }
        },
        "stac": {
          "type": "object",
          "required": [
            "bbox",
            "asset"
          ],
          "additionalProperties": false,
          "description": "which items of a STAC collection to load, and which of their files",
          "properties": {
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "the area, in degrees: [west, south, east, north]"
            },
            "asset": {
              "type": "string",
              "minLength": 1,
              "description": "which file of each item, by its key: `dataops discover` lists them"
            },
            "datetime": {
              "type": "string",
              "minLength": 1,
              "description": "a time or range, as STAC writes it: 2024-06-01/2024-06-30, or 2024-01-01T00:00:00Z/.."
            }
          }
        },
        "raster": {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "description": "make the download one Cloud-Optimised GeoTIFF on the data volume, instead of tables",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.)\\S+\\.tif$",
              "description": "a .tif path under the data volume, like rasters/terrain50.tif"
            },
            "crs": {
              "$ref": "#/$defs/crs"
            },
            "nodata": {
              "type": "number",
              "description": "the value for where no raster covers, and the rasters' own gaps"
            }
          }
        },
        "options": {
          "type": "object",
          "description": "Settings a plugin's source type reads for this dataset (docs/plugins.md)"
        },
        "usgs": {
          "type": "object",
          "required": [
            "bbox"
          ],
          "additionalProperties": false,
          "description": "the area of a National Map dataset, and its format",
          "properties": {
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "the area, in degrees: [west, south, east, north]"
            },
            "format": {
              "type": "string",
              "minLength": 1,
              "description": "the format, when the dataset comes in several: GeoTIFF, GeoPackage, Shapefile, FileGDB"
            }
          }
        },
        "points": {
          "type": "object",
          "additionalProperties": false,
          "description": "a spreadsheet's (CSV, Excel, ODS) coordinate columns, when their names aren't found by themselves: x and y, or wkt; and their CRS",
          "properties": {
            "x": {
              "type": "string",
              "minLength": 1
            },
            "y": {
              "type": "string",
              "minLength": 1
            },
            "wkt": {
              "type": "string",
              "minLength": 1
            },
            "crs": {
              "type": "string",
              "pattern": "^[A-Za-z]+:[0-9]+$"
            }
          }
        }
      }
    }
  }
}
